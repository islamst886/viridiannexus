# Project root URL from Supabase Dashboard -> Settings -> API (do NOT include /rest/v1)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Automated WhatsApp Inquiry Notifications (/api/notifyInquiry - server-side only, NEVER prefix with VITE_)
# Recipient defaults to Site Settings -> whatsappNumber in Admin Panel (optional fallback override below)
# WHATSAPP_RECIPIENT_NUMBER=88017XXXXXXXX
# PUBLIC_SITE_URL=https://viridiannexus.com
# WHATSAPP_PROVIDER=meta_cloud_api # optional override: meta_cloud_api | twilio | webhook

# Option 1: Meta WhatsApp Business Cloud API
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v21.0
# Optional approved utility template (7 variables: ref, category, name, phone, email, subject, brief) for 24/7 out-of-window delivery
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Option 2: Twilio WhatsApp API
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# Option 3: Custom / Automation Webhook (Make, Zapier, n8n, WATI, Evolution API, Green-API, etc.)
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_WEBHOOK_SECRET=
# to start the project
# $env:PATH += ";C:\Program Files\nodejs"; & "C:\Program Files\nodejs\npm.cmd" run dev
# to run tests
# cmd.exe /c "npm test"

# push to github
# git add .
# git commit -m "fix(supabase): resolve booking ledger, activity logs & stage gates, add comprehensive test suite & official WhatsApp branding"
# git push origin supabase-migration
