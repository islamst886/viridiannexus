rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'super_admin');
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'super_admin';
    }

    // Collection: properties (Public read, Admin write)
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Collection: meta and settings (Admin read/write)
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: users (Self read/write, Admin read, SuperAdmin write)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId; // Allow sign up
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
      
      // Wishlist Subcollection (Self read/write, Admin read)
      match /wishlist/{propertyId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      // Notifications Subcollection (Self read/write, Admin write)
      match /notifications/{notifId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isAdmin();
      }
    }
    
    // Collection: bookings (Admin read/write, User read if linked)
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow write: if isAdmin();
      
      // Payments Subcollection
      match /payments/{paymentId} {
        allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.linkedUserId == request.auth.uid);
        allow write: if isAdmin();
      }
      
      // ActivityLog Subcollection
      match /activityLog/{logId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }
    
    // Collection: bookingRequests (Public create, Admin read/write, User read)
    match /bookingRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
    }
    
    // Collection: messages (Public create, Admin read/write)
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Collection: newsletters (Public create, Admin read/write)
    match /newsletters/{emailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
